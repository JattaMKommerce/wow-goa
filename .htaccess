<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Security: Block direct web access to sensitive files (.sqlite, .env, .log, .sql)
  <FilesMatch "\.(sqlite|env|log|sql)$">
    <IfModule mod_authz_core.c>
      Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
      Order deny,allow
      Deny from all
    </IfModule>
  </FilesMatch>

  # Serve APK files with correct MIME type and force attachment download on mobile
  <FilesMatch "\.apk$">
    <IfModule mod_headers.c>
      Header set Content-Type "application/vnd.android.package-archive"
      Header set Content-Disposition "attachment; filename=wowgoa-cabs.apk"
      Header set Cache-Control "no-cache, no-store, must-revalidate"
    </IfModule>
    AddType application/vnd.android.package-archive .apk
  </FilesMatch>

  # Security: repository / source files that were copied onto the server (e.g. by a git clone)
  # must never be served: GitHub workflow (contains the deploy key), app source code, scratch files.
  # The live site does not use any of these paths.
  RewriteRule ^(\.github|frontend|scratch)(/.*)?$ - [R=404,L]
  RewriteRule ^\.cpanel\.yml$ - [R=404,L]

  # Do not rewrite existing files or directories (allows /backend/api.php and static assets to load)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all SPA pages (like /admin, /vendor, etc.) to index.html
  RewriteRule . index.html [L]
</IfModule>

# Prevent caching of index.html and service worker
<FilesMatch "(index\.html|sw\.js)$">
  FileETag None
  <IfModule mod_headers.c>
    Header unset ETag
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>

# -------------------------------------------------------------
# Videos: correct type (the server sent .webm as "text/plain", which made it get
# compressed like text and stream badly), and let browsers keep media for a week
# so the intro / hero videos are not downloaded again on every visit.
# -------------------------------------------------------------
AddType video/webm .webm
AddType video/mp4 .mp4
<FilesMatch "\.(webm|mp4|jpe?g|png|webp|avif|woff2?)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
  </IfModule>
</FilesMatch>

# -------------------------------------------------------------
# Enable GZIP / DEFLATE Compression
# -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/x-javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

# -------------------------------------------------------------
# Prevent LiteSpeed QUIC / HTTP3 Drops (ERR_QUIC_GOAWAY)
# -------------------------------------------------------------
<IfModule mod_headers.c>
  Header always unset Alt-Svc
  Header unset Alt-Svc
</IfModule>


