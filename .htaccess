<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Security: Block direct web access to sensitive files (.sqlite, .env, .log, .sql)
  <FilesMatch "\.(sqlite|env|log|sql)$">
    <IfModule mod_authz_core.c>
      Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
      Order deny,allow
      Deny from all
    </IfModule>
  </FilesMatch>

  # Serve APK files with correct MIME type and force attachment download on mobile
  <FilesMatch "\.apk$">
    <IfModule mod_headers.c>
      Header set Content-Type "application/vnd.android.package-archive"
      Header set Content-Disposition "attachment; filename=\"wowgoa-cabs.apk\""
      Header set Cache-Control "no-cache, no-store, must-revalidate"
    </IfModule>
    AddType application/vnd.android.package-archive .apk
  </FilesMatch>

  # Do not rewrite existing files or directories (allows /backend/api.php and static assets to load)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all SPA pages (like /admin, /vendor, etc.) to index.html
  RewriteRule . index.html [L]
</IfModule>

# Prevent caching of index.html and service worker
<FilesMatch "(index\.html|sw\.js)$">
  FileETag None
  <IfModule mod_headers.c>
    Header unset ETag
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>

