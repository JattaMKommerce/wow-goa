{
  "appId": "com.wowgoa.cabs",
  "appName": "WOW GOA Cabs",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "url": "https://wowgoa.in/cabs?mode=app"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0B192C",
      "showSpinner": false
    }
  }
}
