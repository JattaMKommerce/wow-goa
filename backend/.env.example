DUFFEL_ACCESS_TOKEN=your_duffel_access_token_here
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_MODE=test
GROQ_API_KEY=your_groq_api_key_here

# Sophia AI Assistant Configuration
AI_PROVIDER=openai
AI_API_KEY=your_openai_or_anthropic_api_key_here
AI_MODEL=gpt-4o-mini

# Secret for calling cron_wallet.php / cron_birthday.php by URL (?key=...). Use a long random value.
CRON_SECRET=

# Login-token signing secret (REQUIRED, at least 32 random characters).
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
# Changing it logs everybody out (all existing tokens become invalid).
AUTH_SECRET=
